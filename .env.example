# ─────────────────────────────────────────────────────────────────────────────
# ARGUS — environment configuration
#
# Copy this file to `.env.local` and fill in only what you need:
#
#     cp .env.example .env.local
#
# NOTHING here is required to start. The map uses a free OpenStreetMap basemap
# (MapLibre) when no Mapbox token is set, and rules-based briefs run without any
# AI keys. Add keys below only to unlock the matching feature.
# ─────────────────────────────────────────────────────────────────────────────

# ── App mode ────────────────────────────────────────────────────────────────
# "local" (default) = single-analyst, no accounts. "cloud" = Supabase accounts
# + cross-device sync (requires the NEXT_PUBLIC_SUPABASE_* vars below).
NEXT_PUBLIC_MODE=local
# Public base URL of the deployment (used for share links, OAuth callbacks).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Password protection (optional) ────────────────────────────────────────────
# Set ARGUS_PASSWORD to gate the whole instance behind a password. When it is
# set you MUST also set ARGUS_SESSION_SECRET (generate: openssl rand -hex 32).
# Leave both unset for zero-config local use.
# ARGUS_PASSWORD=
# ARGUS_SESSION_SECRET=
# Dev escape hatch — skip auth entirely (used by e2e). Do NOT set in production.
# ARGUS_DEV_OPEN=false

# ── Map basemap (optional) ──────────────────────────────────────────────────
# Richer Mapbox basemap + 3D terrain. Skip = free OpenStreetMap via MapLibre.
# NEXT_PUBLIC_MAPBOX_TOKEN=
# Google Maps static tiles / geocoding (optional alternative).
# GOOGLE_MAPS_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── AI providers (optional) ─────────────────────────────────────────────────
# Enrich, verify, NLQ, ACH scoring, canvas & country briefs. Rules briefs work
# without these. Set either / both.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Encrypt API keys saved in the in-app Vault (generate: openssl rand -base64 32,
# then prefix with "base64:"). Without it, Vault keys are not persisted server-side.
# VAULT_MASTER_KEY=

# ── Web search / scraping (optional) ────────────────────────────────────────
# Used for aimed collection and full-text enrichment. Any one is enough.
# SERPER_API_KEY=
# BRAVE_API_KEY=
# FIRECRAWL_API_KEY=

# ── News feeds (optional) ───────────────────────────────────────────────────
# NEWS_API_KEY=
# GUARDIAN_API_KEY=

# ── Conflict / humanitarian data (optional) ─────────────────────────────────
# ACLED georeferenced conflict & protest events (free account at acleddata.com).
# ACLED_EMAIL=
# ACLED_PASSWORD=
# ReliefWeb API courtesy identifier (any string; recommended by their ToS).
# RELIEFWEB_APPNAME=argus
# NASA FIRMS active-fire feed (hazard layer).
# NASA_FIRMS_KEY=

# ── Live vessel / aviation tracking (optional) ──────────────────────────────
# AISSTREAM_API_KEY=          # maritime AIS
# OPENSKY_USERNAME=           # ADS-B aircraft positions
# OPENSKY_PASSWORD=

# ── Academic sources (optional) ─────────────────────────────────────────────
# SEMANTIC_SCHOLAR_API_KEY=

# ── Cloud sync — Supabase (only when NEXT_PUBLIC_MODE=cloud) ─────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# GitHub OAuth for cloud sign-in.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Demo data (optional; off by default) ────────────────────────────────────
# NEXT_PUBLIC_DEMO_FALLBACK=false   # inject sample events when all feeds fail
# NEXT_PUBLIC_DEMO_PROJECTS=false   # pre-seed the home screen with demo projects
